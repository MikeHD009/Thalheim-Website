server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /otlp/ {
        proxy_pass ${ONEUPTIME_INGEST_URL}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header x-oneuptime-token "${ONEUPTIME_TOKEN}";
        proxy_ssl_server_name on;
        limit_req zone=rum_limit burst=20 nodelay;
    }
}